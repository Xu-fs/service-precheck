# 非机密正式运行模板，真实值在仓库外配置；不要将密钥写入本文件。
ZHENGWU_RUNTIME_DIR=
ZHENGWU_PUBLIC_URL=
# 逗号分隔的域名，不含协议或端口；须包含PUBLIC_URL中的域名。
ZHENGWU_ALLOWED_HOSTS=
ZHENGWU_STAFF_JWT_SECRET=
ZHENGWU_TLS_CERT=
ZHENGWU_TLS_KEY=
ZHENGWU_CONFIG_VERSION=
ZHENGWU_SECURE_COOKIES=true
ZHENGWU_PRIVATE_STORAGE_CONFIRMED=false
ZHENGWU_PORT=8000
# 配额按作用域集成；额度须由服务负责人批准，不能用字符长度代替token预算。
# 同机SQLite；跨主机须另配共享配额服务。
